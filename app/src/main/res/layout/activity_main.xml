<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_bg"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivIslamicBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.72"
        android:contentDescription="Islamic Geometric Pattern Background"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_islamic_pattern"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBrandLogo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_glass_badge"
            android:contentDescription="MYCAR Logo"
            android:padding="5dp"
            android:src="@drawable/ic_car_logo" />

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:letterSpacing="0.18"
            android:text="MYCAR"
            android:textColor="@color/night_accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_glass_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="LAMP SYNC - READY"
            android:textColor="@color/night_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnRestoreHome"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_button"
            android:paddingHorizontal="14dp"
            android:text="Home Settings"
            android:textAllCaps="false"
            android:textColor="@color/night_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnApps"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_button"
            android:paddingHorizontal="16dp"
            android:text="Apps"
            android:textAllCaps="false"
            android:textColor="@color/night_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/leftCluster"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/musicCard"
        app:layout_constraintEnd_toStartOf="@id/mapCard"
        app:layout_constraintHorizontal_weight="1.2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:id="@+id/clockWeatherCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.15"
            android:background="@drawable/bg_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.35"
                android:background="@drawable/bg_glass_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <com.mycar.launcher.LuxuryAnalogClockView
                    android:id="@+id/analogClockView"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBigClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="06:48"
                        android:textColor="@color/night_text"
                        android:textSize="54sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Wed, 25 Nov - Kuantan"
                        android:textColor="@color/night_subtext"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/weatherBadgeBox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="0.95"
                android:background="@drawable/bg_glass_badge"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvWeatherIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌦"
                    android:textColor="@color/night_accent"
                    android:textSize="36sp" />

                <TextView
                    android:id="@+id/tvWeatherTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="--°C"
                    android:textColor="@color/night_text"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWeatherDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Syncing..."
                    android:textColor="@color/night_subtext"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/telemetryCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1.15"
            android:background="@drawable/bg_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:id="@+id/speedGlassBox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.75"
                android:background="@drawable/bg_glass_badge"
                android:padding="6dp">

                <com.mycar.launcher.LuxurySpeedGaugeView
                    android:id="@+id/speedGaugeView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSpeedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.14"
                        android:text="SPEED"
                        android:textColor="@color/night_subtext"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="none"
                        android:maxLines="1"
                        android:text="0"
                        android:textColor="@color/night_accent"
                        android:textSize="58sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpeedUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="KM/H"
                        android:textColor="@color/night_subtext"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="0.78"
                android:background="@drawable/bg_glass_badge"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tvMaxLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="MAX"
                    android:textColor="@color/night_subtext"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMaxSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:text="0"
                    android:textColor="@color/night_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMaxUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KM/H"
                    android:textColor="@color/night_subtext"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="0.78"
                android:background="@drawable/bg_glass_badge"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tvAvgLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="AVG"
                    android:textColor="@color/night_subtext"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAvgSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:text="0.0"
                    android:textColor="@color/night_accent"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAvgUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KM/H"
                    android:textColor="@color/night_subtext"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mapCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/musicCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/leftCluster"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:id="@+id/tvMapTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="◈ OpenStreetMap Live"
            android:textColor="@color/night_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLocationHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Location: Detecting location..."
            android:textColor="@color/night_subtext"
            android:textSize="12sp" />

        <WebView
            android:id="@+id/osmWebView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/musicCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/ivMusicCarIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_glass_badge"
            android:contentDescription="Media Source"
            android:padding="5dp"
            android:src="@drawable/ic_car_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="[PAUSE] YTM LIST #1 - Highway Breeze - Chill Acoustic"
                android:textColor="@color/night_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlayNextList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Next: 1. Synthwave Cruise  |  2. Lo-Fi Beats"
                android:textColor="@color/night_subtext"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnNextList"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_glass_button"
            android:paddingHorizontal="12dp"
            android:text="Next List"
            android:textAllCaps="false"
            android:textColor="@color/night_text" />

        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_button"
            android:paddingHorizontal="14dp"
            android:text="Play"
            android:textAllCaps="false"
            android:textColor="@color/night_accent"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNextTrack"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_button"
            android:paddingHorizontal="12dp"
            android:text="Next"
            android:textAllCaps="false"
            android:textColor="@color/night_text" />

        <Button
            android:id="@+id/btnSwitchSource"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_button"
            android:paddingHorizontal="14dp"
            android:text="Radio"
            android:textAllCaps="false"
            android:textColor="@color/night_accent"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
